# Google Cloud Configuration
# Using Application Default Credentials (ADC) - No service account key needed!
# Run: gcloud auth application-default login
# Run: gcloud auth application-default set-quota-project YOUR_PROJECT_ID

# Document AI Configuration
DOCAI_PROJECT_ID=
DOCAI_LOCATION=
DOCAI_PROCESSOR_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# Server Configuration
PORT=3001
SESSION_SECRET=
JWT_SECRET=
# Optional override if frontend handles callback somewhere else
# AUTH_CALLBACK_PATH=/auth/callback

# LLMWhisperer API Key
LLMWHISPERER_API_KEY=

# Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=
